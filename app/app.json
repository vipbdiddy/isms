{
  "expo": {
    "name": "Isms",
    "slug": "isms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vipbdiddy.isms"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vipbdiddy.isms",
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "themeColor": "#F2F7F6",
      "description": "Keep the sayings and stories of the people you've lost."
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Isms uses your photos so you can add a picture of your loved one.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F2F7F6"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Isms checks your contacts' email addresses, only when you ask, to find friends who already use Isms. Your contacts are never uploaded."
        }
      ]
    ],
    "scheme": "isms"
  }
}
